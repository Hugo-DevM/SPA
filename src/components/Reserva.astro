---
import { Icon } from 'astro-icon/components';
import {
  reserva,
  tratamientos,
  cabinas,
  CABINA_INDIFERENTE,
  contacto,
  pago,
  CTA_PRINCIPAL,
} from '../data/spa';

const dinero = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});

const DIAS_CORTOS = ['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do'];
---

<!-- Familia: bloque de color con panel blanco dentro y lomo girado al margen.
     Es el único sitio de la página donde hay que operar, así que es el único
     que se levanta del lienzo con una superficie propia. -->
<section class="reserva seccion lienzo--blush" id="reservar">
  <div class="envoltura reserva__caja">
    <p class="lomo reserva__lomo" aria-hidden="true">{reserva.rotulo}</p>

    <div class="reserva__alto revelar">
      <p class="sobre-titulo">{reserva.texto}</p>
      <h2>{reserva.titulo} {reserva.tituloAcento}</h2>
    </div>

    <div class="reserva__panel lienzo--blanco revelar">
      <form class="flujo" id="form-reserva" novalidate>
        <!-- ------------------------------ Paso 1 ------------------------- -->
        <fieldset class="paso">
          <legend><span class="paso__num">1</span> Qué te hacemos</legend>

          <div class="opciones opciones--tratamientos">
            {
              tratamientos.map((t, i) => (
                <label class="opcion">
                  <input
                    type="radio"
                    name="tratamiento"
                    value={t.slug}
                    data-nombre={t.nombre}
                    data-precio={t.precio}
                    data-duracion={t.duracionMin}
                    data-buffer={t.bufferMin}
                    data-anticipo={t.anticipo}
                    checked={i === 0}
                  />
                  <span class="opcion__caja">
                    <span class="opcion__nombre">{t.nombre}</span>
                    <span class="opcion__meta">
                      <span class="opcion__precio">{dinero.format(t.precio)}</span>
                      <span aria-hidden="true">·</span>
                      <span>{t.duracionMin} min</span>
                    </span>
                    {t.anticipo > 0 && (
                      <span class="opcion__anticipo">{dinero.format(t.anticipo)} de anticipo</span>
                    )}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- ------------------------------ Paso 2 ------------------------- -->
        <fieldset class="paso">
          <legend><span class="paso__num">2</span> En qué cabina</legend>

          <div class="opciones opciones--cabinas">
            <label class="opcion">
              <input type="radio" name="cabina" value="" data-nombre={CABINA_INDIFERENTE.nombre} checked />
              <span class="opcion__caja">
                <span class="opcion__nombre">{CABINA_INDIFERENTE.nombre}</span>
                <span class="opcion__nota">Te damos la que llene mejor la tarde</span>
              </span>
            </label>

            {
              cabinas.lista.map((c) => (
                <label class="opcion">
                  <input type="radio" name="cabina" value={c.slug} data-nombre={c.nombre} />
                  <span class="opcion__caja">
                    <span class="opcion__nombre">{c.nombre}</span>
                    <span class="opcion__nota">{c.detalle}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- ------------------------------ Paso 3 ------------------------- -->
        <fieldset class="paso">
          <legend><span class="paso__num">3</span> Qué día</legend>

          <div class="calendario" id="calendario">
            <div class="calendario__barra">
              <button class="calendario__mover" type="button" id="mes-atras" aria-label="Mes anterior">
                <Icon name="ph:caret-left" aria-hidden="true" />
              </button>
              <p class="calendario__titulo" id="mes-titulo" aria-live="polite"></p>
              <button class="calendario__mover" type="button" id="mes-adelante" aria-label="Mes siguiente">
                <Icon name="ph:caret-right" aria-hidden="true" />
              </button>
            </div>

            <div class="calendario__dias" aria-hidden="true">
              {DIAS_CORTOS.map((d) => <span>{d}</span>)}
            </div>

            <div class="calendario__rejilla" id="calendario-rejilla" role="group" aria-label="Días disponibles"></div>
          </div>
        </fieldset>

        <!-- ------------------------------ Paso 4 ------------------------- -->
        <fieldset class="paso">
          <legend><span class="paso__num">4</span> A qué hora</legend>
          <div class="horarios" id="horarios"></div>
        </fieldset>

        <!-- ------------------------------ Paso 5 ------------------------- -->
        <fieldset class="paso">
          <legend><span class="paso__num">5</span> Tus datos</legend>

          <div class="campos">
            <div class="campo">
              <label for="r-nombre">Nombre</label>
              <input type="text" id="r-nombre" name="nombre" autocomplete="name" placeholder="Renata Vilchis" required aria-describedby="r-nombre-error" />
              <p class="campo__error" id="r-nombre-error" data-error hidden>
                <Icon name="ph:warning-circle" aria-hidden="true" />
                <span></span>
              </p>
            </div>

            <div class="campo">
              <label for="r-telefono">Teléfono</label>
              <input type="tel" id="r-telefono" name="telefono" autocomplete="tel" inputmode="tel" placeholder="33 1234 5678" required aria-describedby="r-telefono-error" />
              <p class="campo__error" id="r-telefono-error" data-error hidden>
                <Icon name="ph:warning-circle" aria-hidden="true" />
                <span></span>
              </p>
            </div>

            <div class="campo">
              <label for="r-correo">
                Correo
                <span class="campo__opcional">Opcional</span>
              </label>
              <input type="email" id="r-correo" name="correo" autocomplete="email" placeholder="renata@correo.com" aria-describedby="r-correo-error" />
              <p class="campo__error" id="r-correo-error" data-error hidden>
                <Icon name="ph:warning-circle" aria-hidden="true" />
                <span></span>
              </p>
            </div>

            <div class="campo campo--ancho">
              <label for="r-notas">
                Algo que debamos saber
                <span class="campo__opcional">Opcional</span>
              </label>
              <textarea id="r-notas" name="notas" rows="2" maxlength="280" placeholder="Estoy embarazada, tengo la piel sensible, vengo con mi hermana…"></textarea>
            </div>

            <div class="campo campo--ancho">
              <label class="casilla" for="r-aviso">
                <input type="checkbox" id="r-aviso" name="aviso" required aria-describedby="r-aviso-error" />
                <span>
                  Acepto que la casa use mi teléfono para confirmarme y recordarme la cita,
                  según el <a class="enlace" href="/aviso-de-privacidad">aviso de privacidad</a>.
                </span>
              </label>
              <p class="campo__error" id="r-aviso-error" data-error hidden>
                <Icon name="ph:warning-circle" aria-hidden="true" />
                <span></span>
              </p>
            </div>
          </div>
        </fieldset>

        <!-- ------------------------------ Resumen ------------------------ -->
        <aside class="resumen lienzo--taupe" aria-label="Resumen de tu cita">
          <p class="resumen__titulo">Tu cita</p>

          <dl class="resumen__lista">
            <div>
              <dt>Tratamiento</dt>
              <dd id="res-tratamiento">-</dd>
            </div>
            <div>
              <dt>Cabina</dt>
              <dd id="res-cabina">-</dd>
            </div>
            <div>
              <dt>Día</dt>
              <dd id="res-dia">Sin elegir</dd>
            </div>
            <div>
              <dt>Hora</dt>
              <dd id="res-hora">Sin elegir</dd>
            </div>
          </dl>

          <div class="resumen__total">
            <span>Total</span>
            <strong id="res-total">-</strong>
          </div>

          <div class="resumen__anticipo" id="res-anticipo-caja" hidden>
            <span>Anticipo para apartar</span>
            <strong id="res-anticipo">-</strong>
            <small id="res-resta">-</small>
          </div>

          <p class="resumen__nota">
            <Icon name="ph:check-circle" aria-hidden="true" />
            <span id="res-nota">La cabina queda apartada en cuanto confirmas.</span>
          </p>
        </aside>

        <div class="enviar">
          <button class="btn btn--lg" type="submit" id="enviar-reserva">
            <span class="enviar__texto">{CTA_PRINCIPAL}</span>
            <Icon name="ph:circle-notch" class="giro" aria-hidden="true" />
          </button>
          <p class="enviar__nota">
            <Icon name="ph:lock-simple" aria-hidden="true" />
            <span id="enviar-nota">No pedimos tarjeta. Pagas en la casa.</span>
          </p>
        </div>

        <p class="aviso" id="reserva-aviso" role="status" aria-live="polite" hidden></p>
      </form>

      <!-- --------------------------- Confirmación --------------------------- -->
      <div class="confirmada" id="confirmada" hidden>
        <div class="confirmada__sello" aria-hidden="true">
          <Icon name="ph:check" />
        </div>

        <h3 id="conf-titulo">Listo, tu cabina está apartada</h3>
        <p class="confirmada__folio">Folio <strong id="conf-folio">-</strong></p>

        <dl class="confirmada__lista">
          <div>
            <dt>Tratamiento</dt>
            <dd id="conf-tratamiento">-</dd>
          </div>
          <div>
            <dt>Cabina</dt>
            <dd id="conf-cabina">-</dd>
          </div>
          <div>
            <dt>Cuándo</dt>
            <dd id="conf-cuando">-</dd>
          </div>
          <div>
            <dt>Dónde</dt>
            <dd>{contacto.calle}, {contacto.colonia}</dd>
          </div>
        </dl>

        <p class="confirmada__texto" id="conf-texto"></p>

        <!-- ------------------------ Anticipo por SPEI ---------------------- -->
        <section class="anticipo lienzo--blush" id="anticipo" hidden aria-labelledby="anticipo-titulo">
          <div class="anticipo__cabeza">
            <Icon name="ph:hourglass-high" aria-hidden="true" />
            <h4 id="anticipo-titulo">{pago.titulo}</h4>
          </div>

          <p class="anticipo__texto">{pago.texto}</p>
          <p class="anticipo__reloj" id="anticipo-reloj" role="status" aria-live="polite"></p>

          <dl class="anticipo__datos">
            <div>
              <dt>Monto a transferir</dt>
              <dd class="anticipo__monto" id="anticipo-monto">-</dd>
            </div>
            <div>
              <dt>Banco</dt>
              <dd>{pago.banco}</dd>
            </div>
            <div>
              <dt>Titular</dt>
              <dd>{pago.titular}</dd>
            </div>
            <div>
              <dt>CLABE</dt>
              <dd class="anticipo__copiable">
                <span class="anticipo__dato">{pago.clabe}</span>
                <button class="anticipo__copiar" type="button" data-copiar={pago.clabePlana}>
                  <Icon name="ph:copy" aria-hidden="true" />
                  <span>Copiar</span>
                </button>
              </dd>
            </div>
            <div>
              <dt>Concepto o referencia</dt>
              <dd class="anticipo__copiable">
                <span class="anticipo__dato" id="anticipo-folio">-</span>
                <button class="anticipo__copiar" type="button" id="copiar-folio">
                  <Icon name="ph:copy" aria-hidden="true" />
                  <span>Copiar</span>
                </button>
              </dd>
            </div>
          </dl>

          <ol class="anticipo__pasos">
            {pago.instrucciones.map((p) => <li>{p}</li>)}
          </ol>

          <form class="anticipo__subida" id="form-comprobante" novalidate>
            <label class="anticipo__etiqueta" for="comprobante">
              Captura del comprobante
              <span class="anticipo__formatos">
                JPG, PNG, WEBP, HEIC o PDF · hasta {pago.pesoMaximoMb} MB
              </span>
            </label>
            <input type="file" id="comprobante" name="comprobante" accept={pago.formatos.join(',')} />
            <button class="btn" type="submit" id="comprobante-enviar">
              <span class="comprobante__texto">Enviar comprobante</span>
              <Icon name="ph:circle-notch" class="giro" aria-hidden="true" />
            </button>
          </form>

          <div class="anticipo__listo" id="anticipo-listo" hidden>
            <Icon name="ph:check-circle" aria-hidden="true" />
            <div>
              <strong>Recibimos tu comprobante</strong>
              <p>
                Tu cabina ya no se libera. Lo revisamos y te confirmamos por WhatsApp; si algo
                no cuadra te escribimos al teléfono que nos dejaste.
              </p>
            </div>
          </div>

          <p class="anticipo__aviso">
            <Icon name="ph:warning-circle" aria-hidden="true" />
            {pago.aviso}
          </p>

          <p class="aviso" id="comprobante-aviso" role="status" aria-live="polite" hidden></p>
        </section>

        <div class="confirmada__botones">
          <div class="agregar">
            <button
              class="btn btn--linea agregar__abrir"
              type="button"
              id="cal-abrir"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="cal-menu"
            >
              <Icon name="ph:calendar-check" aria-hidden="true" />
              Añadir a mi calendario
              <Icon name="ph:caret-down" class="agregar__flecha" aria-hidden="true" />
            </button>

            <div class="agregar__menu" id="cal-menu" role="menu" aria-labelledby="cal-abrir" hidden>
              <a
                class="agregar__opcion"
                id="cal-google"
                role="menuitem"
                href="#"
                target="_blank"
                rel="noopener"
              >
                <Icon name="ph:google-logo" aria-hidden="true" />
                Google Calendar
              </a>
              <a
                class="agregar__opcion"
                id="cal-outlook"
                role="menuitem"
                href="#"
                target="_blank"
                rel="noopener"
              >
                <Icon name="ph:microsoft-outlook-logo" aria-hidden="true" />
                Outlook
              </a>
              <a
                class="agregar__opcion"
                id="cal-ics"
                role="menuitem"
                href="#"
                download="cita-casa-vapor.ics"
              >
                <Icon name="ph:apple-logo" aria-hidden="true" />
                <span>
                  Apple Calendar u otro
                  <small>Descarga un archivo .ics</small>
                </span>
              </a>
            </div>
          </div>
          <a class="btn btn--linea" id="conf-whatsapp" href="#" target="_blank" rel="noopener">
            <Icon name="ph:whatsapp-logo" aria-hidden="true" />
            Escribirnos
          </a>
          <button class="confirmada__otra" type="button" id="conf-otra">Agendar otra cita</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    cargarAgenda,
    reservar,
    subirComprobante,
    huecosDelDia,
    diaTieneHuecos,
    ahoraEnCasa,
    instanteUtc,
    fechaLegible,
    horaLegible,
    partesFecha,
    aFecha,
    diaSemana,
    diasEnMes,
    sumarDias,
    tiempoRestante,
    MINIMO_VENDIBLE,
    ErrorReserva,
    HAY_SUPABASE,
    type Agenda,
    type EstadoPago,
  } from '../lib/reservas';
  import { reserva, contacto, marca, pago, tratamientos as catalogo } from '../data/spa';

  const formulario = document.getElementById('form-reserva') as HTMLFormElement | null;
  if (formulario) iniciar(formulario);

  function iniciar(formulario: HTMLFormElement) {
    /* ------------------------------- Estado ------------------------------- */

    const hoy = ahoraEnCasa().fecha;
    const ultimoDia = sumarDias(hoy, reserva.diasDeAntelacion);

    let agenda: Agenda | null = null;
    let mesVisible = { anio: partesFecha(hoy).anio, mes: partesFecha(hoy).mes };
    let diaElegido: string | null = null;
    let horaElegida: string | null = null;
    let citaEnCurso: { folio: string; telefono: string } | null = null;
    let relojAnticipo: number | null = null;
    let urlCalendario: string | null = null;

    const dinero = new Intl.NumberFormat('es-MX', {
      style: 'currency',
      currency: 'MXN',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    });

    const nombreMes = new Intl.DateTimeFormat('es-MX', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });

    /* -------------------------------- Nodos ------------------------------- */

    const rejilla = document.getElementById('calendario-rejilla')!;
    const tituloMes = document.getElementById('mes-titulo')!;
    const atras = document.getElementById('mes-atras') as HTMLButtonElement;
    const adelante = document.getElementById('mes-adelante') as HTMLButtonElement;
    const cajaHorarios = document.getElementById('horarios')!;
    const aviso = document.getElementById('reserva-aviso')!;
    const boton = document.getElementById('enviar-reserva') as HTMLButtonElement;
    const confirmada = document.getElementById('confirmada')!;
    const cajaAnticipo = document.getElementById('anticipo')!;
    const formComprobante = document.getElementById('form-comprobante') as HTMLFormElement;
    const campoComprobante = document.getElementById('comprobante') as HTMLInputElement;
    const botonComprobante = document.getElementById('comprobante-enviar') as HTMLButtonElement;
    const avisoComprobante = document.getElementById('comprobante-aviso')!;
    const listoAnticipo = document.getElementById('anticipo-listo')!;
    const relojTexto = document.getElementById('anticipo-reloj')!;
    const abrirCalendario = document.getElementById('cal-abrir') as HTMLButtonElement;
    const menuCalendario = document.getElementById('cal-menu')!;
    const enlaceGoogleCal = document.getElementById('cal-google') as HTMLAnchorElement;
    const enlaceOutlookCal = document.getElementById('cal-outlook') as HTMLAnchorElement;
    const enlaceIcs = document.getElementById('cal-ics') as HTMLAnchorElement;

    const resumen = {
      tratamiento: document.getElementById('res-tratamiento')!,
      cabina: document.getElementById('res-cabina')!,
      dia: document.getElementById('res-dia')!,
      hora: document.getElementById('res-hora')!,
      total: document.getElementById('res-total')!,
      anticipoCaja: document.getElementById('res-anticipo-caja')!,
      anticipo: document.getElementById('res-anticipo')!,
      resta: document.getElementById('res-resta')!,
      nota: document.getElementById('res-nota')!,
      notaEnviar: document.getElementById('enviar-nota')!,
    };

    function tratamientoElegido() {
      const radio = formulario.querySelector<HTMLInputElement>('input[name="tratamiento"]:checked')!;
      return {
        slug: radio.value,
        nombre: radio.dataset.nombre!,
        precio: Number(radio.dataset.precio),
        duracionMin: Number(radio.dataset.duracion),
        bufferMin: Number(radio.dataset.buffer),
        anticipo: Number(radio.dataset.anticipo ?? 0),
      };
    }

    function cabinaElegida() {
      const radio = formulario.querySelector<HTMLInputElement>('input[name="cabina"]:checked')!;
      return { slug: radio.value || null, nombre: radio.dataset.nombre! };
    }

    /* ------------------------------ Calendario ---------------------------- */

    /* Primer día con lugar dentro de la ventana de agenda, o null.

       Hace falta por un caso que parece raro y pasa todos los meses: si hoy es
       el día 30 y el tratamiento ya no cabe hoy, el mes visible se queda SIN un
       solo día disponible. Sin esto el calendario enseñaría un mes entero
       apagado y nadie sabría que hay lugar pasando de mes. */
    function primerDiaConHueco(trat: { duracionMin: number; bufferMin: number }, cabSlug: string | null) {
      if (!agenda) return null;
      let fecha = hoy;
      while (fecha <= ultimoDia) {
        if (diaTieneHuecos(agenda, fecha, trat, cabSlug)) return fecha;
        fecha = sumarDias(fecha, 1);
      }
      return null;
    }

    function pintarCalendario() {
      const { anio, mes } = mesVisible;
      const etiqueta = nombreMes.format(new Date(Date.UTC(anio, mes - 1, 1)));
      tituloMes.textContent = etiqueta.charAt(0).toUpperCase() + etiqueta.slice(1);

      const primero = aFecha(anio, mes, 1);
      const ultimo = aFecha(anio, mes, diasEnMes(anio, mes));
      atras.disabled = primero <= hoy;
      adelante.disabled = ultimo >= ultimoDia;

      rejilla.replaceChildren();

      if (!agenda) {
        const cargando = document.createElement('p');
        cargando.className = 'calendario__cargando';
        cargando.textContent = 'Buscando lugares…';
        rejilla.append(cargando);
        return;
      }

      const trat = tratamientoElegido();
      const cab = cabinaElegida();
      let hayAlgunoEsteMes = false;

      // La rejilla empieza en lunes; diaSemana() devuelve 0 para domingo.
      const desfase = (diaSemana(primero) + 6) % 7;
      for (let i = 0; i < desfase; i += 1) {
        const hueco = document.createElement('span');
        hueco.className = 'dia dia--hueco';
        rejilla.append(hueco);
      }

      for (let numero = 1; numero <= diasEnMes(anio, mes); numero += 1) {
        const fecha = aFecha(anio, mes, numero);
        const celda = document.createElement('button');
        celda.type = 'button';
        celda.className = 'dia';
        celda.textContent = String(numero);
        celda.dataset.fecha = fecha;

        const dentro = fecha >= hoy && fecha <= ultimoDia;
        const libre = dentro && diaTieneHuecos(agenda, fecha, trat, cab.slug);

        if (!libre) {
          celda.disabled = true;
          celda.setAttribute(
            'aria-label',
            `${fechaLegible(fecha)}, sin lugar para ${trat.nombre}`
          );
        } else {
          hayAlgunoEsteMes = true;
          celda.classList.add('dia--libre');
          celda.setAttribute('aria-label', fechaLegible(fecha));
          celda.addEventListener('click', () => elegirDia(fecha));
        }

        if (fecha === diaElegido) {
          celda.classList.add('dia--elegido');
          celda.setAttribute('aria-current', 'date');
        }

        rejilla.append(celda);
      }

      /* Mes sin un solo día disponible. En vez de dejar la rejilla apagada y
         que la clienta crea que no hay lugar nunca, se le dice dónde sí hay y
         se le da el salto en un clic. */
      if (!hayAlgunoEsteMes) {
        const siguiente = primerDiaConHueco(trat, cab.slug);
        const aviso = document.createElement('p');
        aviso.className = 'calendario__sin-mes';

        if (!siguiente) {
          aviso.textContent = `No queda lugar para ${trat.nombre} en los próximos ${reserva.diasDeAntelacion} días. Escríbenos por WhatsApp y lo acomodamos a mano.`;
        } else {
          const { anio: a2, mes: m2 } = partesFecha(siguiente);
          const etiquetaSig = nombreMes.format(new Date(Date.UTC(a2, m2 - 1, 1)));
          aviso.textContent = `Este mes ya no hay lugar para ${trat.nombre}. `;

          const salto = document.createElement('button');
          salto.type = 'button';
          salto.className = 'calendario__salto';
          salto.textContent = `Ver ${etiquetaSig.toLowerCase()}`;
          salto.addEventListener('click', () => {
            mesVisible = { anio: a2, mes: m2 };
            pintarCalendario();
          });

          aviso.append(salto);
        }

        rejilla.append(aviso);
      }
    }

    function elegirDia(fecha: string) {
      diaElegido = fecha;
      horaElegida = null;
      pintarCalendario();
      pintarHorarios();
      actualizarResumen();
    }

    /* ------------------------------- Horarios ------------------------------
       Aquí se ve el trabajo del motor. Las horas se parten en dos grupos:

         - Las que llenan apretado, incluidas las ANCLADAS al minuto en que la
           cabina queda libre. Estas van primero y son el camino por defecto.
         - Las que dejarían un espacio por debajo del tratamiento más corto.
           Van aparte, en "otros horarios", visibles pero no destacadas.

       No se esconden: si a la clienta solo le queda a esa hora, esconderla
       cuesta una venta. Pero el camino fácil es el que llena mejor la tarde. */

    function pintarHorarios() {
      cajaHorarios.replaceChildren();

      if (!agenda || !diaElegido) {
        const vacio = document.createElement('p');
        vacio.className = 'horarios__vacio';
        vacio.textContent = 'Elige un día y te enseñamos las horas que quedan.';
        cajaHorarios.append(vacio);
        return;
      }

      const trat = tratamientoElegido();
      const cab = cabinaElegida();
      const huecos = huecosDelDia(agenda, diaElegido, trat, cab.slug);

      if (huecos.length === 0) {
        const nada = document.createElement('p');
        nada.className = 'horarios__vacio';
        nada.textContent = 'Ese día no abrimos. Elige otro.';
        cajaHorarios.append(nada);
        return;
      }

      const apretados = huecos.filter((h) => h.libres === 0 || !h.dejaHueco);
      const sueltos = huecos.filter((h) => h.libres > 0 && h.dejaHueco);

      const chip = (h: (typeof huecos)[number]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'hora';
        b.textContent = horaLegible(h.hora);
        b.dataset.hora = h.hora;

        if (h.libres === 0) {
          b.disabled = true;
          b.setAttribute('aria-label', `${horaLegible(h.hora)}, ya reservado`);
          b.title = 'Ya reservado';
        } else {
          b.setAttribute('aria-pressed', String(h.hora === horaElegida));
          if (h.anclado) {
            b.dataset.anclado = 'true';
            b.title = 'Justo cuando queda libre la cabina';
          }
          b.addEventListener('click', () => {
            horaElegida = h.hora;
            pintarHorarios();
            actualizarResumen();
          });
        }

        if (h.hora === horaElegida) b.classList.add('hora--elegida');
        return b;
      };

      const grupo = document.createElement('div');
      grupo.className = 'horarios__rejilla';
      apretados.forEach((h) => grupo.append(chip(h)));
      cajaHorarios.append(grupo);

      const libres = huecos.filter((h) => h.libres > 0).length;
      const pie = document.createElement('p');
      pie.className = 'horarios__pie';
      pie.textContent = `${libres} de ${huecos.length} horas libres para ${trat.duracionMin} minutos.`;
      cajaHorarios.append(pie);

      if (sueltos.length > 0) {
        const detalle = document.createElement('details');
        detalle.className = 'horarios__otros';

        const resumenEl = document.createElement('summary');
        resumenEl.textContent = `Otros ${sueltos.length} horarios`;
        detalle.append(resumenEl);

        const nota = document.createElement('p');
        nota.className = 'horarios__nota';
        nota.textContent =
          `A estas horas sí te podemos atender, pero dejan un hueco de menos de ${MINIMO_VENDIBLE} minutos que ya no alcanza para nadie más. Si te queda mejor una de estas, tómala sin problema.`;
        detalle.append(nota);

        const rejillaOtros = document.createElement('div');
        rejillaOtros.className = 'horarios__rejilla';
        sueltos.forEach((h) => rejillaOtros.append(chip(h)));
        detalle.append(rejillaOtros);

        cajaHorarios.append(detalle);
      }
    }

    /* ------------------------------- Resumen ------------------------------ */

    function actualizarResumen() {
      const trat = tratamientoElegido();
      const cab = cabinaElegida();

      resumen.tratamiento.textContent = `${trat.nombre} · ${trat.duracionMin} min`;
      resumen.cabina.textContent = cab.nombre;
      resumen.total.textContent = dinero.format(trat.precio);

      const conAnticipo = trat.anticipo > 0;
      resumen.anticipoCaja.hidden = !conAnticipo;

      if (conAnticipo) {
        resumen.anticipo.textContent = dinero.format(trat.anticipo);
        resumen.resta.textContent = `Pagas ${dinero.format(trat.precio - trat.anticipo)} el día de tu cita`;
        resumen.nota.textContent = `La cabina se aparta ${pago.plazoHoras} horas mientras llega tu transferencia.`;
        resumen.notaEnviar.textContent = 'Sin tarjeta: el anticipo va por transferencia, sin comisión.';
      } else {
        resumen.nota.textContent = 'La cabina queda apartada en cuanto confirmas.';
        resumen.notaEnviar.textContent = 'No pedimos tarjeta. Pagas en la casa.';
      }

      resumen.dia.textContent = diaElegido ? fechaLegible(diaElegido) : 'Sin elegir';
      resumen.dia.dataset.vacio = String(!diaElegido);
      resumen.hora.textContent = horaElegida ? horaLegible(horaElegida) : 'Sin elegir';
      resumen.hora.dataset.vacio = String(!horaElegida);
    }

    /* -------------------------- Carga de la agenda ------------------------ */

    let ultimaCarga = 0;
    let primeraCarga = true;

    async function traerAgenda() {
      try {
        agenda = await cargarAgenda(hoy, ultimoDia);
        ultimaCarga = Date.now();
      } catch {
        mostrarAviso(
          'error',
          `No pudimos cargar la agenda. Recarga la página o llámanos al ${contacto.telefono}.`
        );
        agenda = { horarios: [], cabinas: [], ocupados: [], bloqueos: [] };
      }

      /* En la primera carga se abre el calendario en el mes donde de verdad hay
         lugar. Si hoy es fin de mes y ya no cabe nada, abrir en el mes actual
         sería recibir a la clienta con una rejilla entera apagada. */
      if (primeraCarga && agenda) {
        primeraCarga = false;
        const trat = tratamientoElegido();
        const cab = cabinaElegida();
        const primero = primerDiaConHueco(trat, cab.slug);
        if (primero) {
          const { anio, mes } = partesFecha(primero);
          mesVisible = { anio, mes };
        }
      }

      pintarCalendario();
      pintarHorarios();
    }

    /* Si alguien deja la pestaña abierta y vuelve, la agenda que tiene en
       pantalla puede estar mintiendo. Se vuelve a pedir al recuperar el foco. */
    document.addEventListener('visibilitychange', async () => {
      if (document.visibilityState !== 'visible') return;
      if (Date.now() - ultimaCarga < 60_000) return;
      await traerAgenda();
      if (diaElegido && horaElegida && agenda) {
        const trat = tratamientoElegido();
        const cab = cabinaElegida();
        const sigue = huecosDelDia(agenda, diaElegido, trat, cab.slug).some(
          (h) => h.hora === horaElegida && h.libres > 0
        );
        if (!sigue) {
          horaElegida = null;
          pintarHorarios();
          actualizarResumen();
          mostrarAviso('error', 'Alguien tomó la hora que tenías elegida. Elige otra, por favor.');
        }
      }
    });

    /* ------------------------------ Validación ---------------------------- */

    const reglas: Record<string, (v: string) => string | null> = {
      nombre: (v) => (v.trim().length < 3 ? 'Escribe tu nombre completo.' : null),
      telefono: (v) => {
        const d = v.replace(/\D/g, '');
        return d.length < 10 || d.length > 13 ? 'Diez dígitos, con lada.' : null;
      },
      correo: (v) =>
        !v.trim() || /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())
          ? null
          : 'Revisa el correo, algo no cuadra.',
      aviso: () => null,
    };

    function valorDe(control: HTMLInputElement | HTMLTextAreaElement) {
      return control.type === 'checkbox' ? String((control as HTMLInputElement).checked) : control.value;
    }

    function pintarError(control: HTMLElement, mensaje: string | null) {
      const campo = control.closest<HTMLElement>('.campo');
      if (!campo) return;
      const caja = campo.querySelector<HTMLElement>('[data-error]');
      const texto = caja?.querySelector('span');
      if (mensaje) {
        campo.setAttribute('data-invalido', 'true');
        if (caja && texto) {
          texto.textContent = mensaje;
          caja.hidden = false;
        }
      } else {
        campo.removeAttribute('data-invalido');
        if (caja) caja.hidden = true;
      }
    }

    function validar(control: HTMLInputElement | HTMLTextAreaElement) {
      if (control.name === 'aviso') {
        const ok = (control as HTMLInputElement).checked;
        pintarError(control, ok ? null : 'Necesitamos tu permiso para confirmarte la cita.');
        return ok;
      }
      const regla = reglas[control.name];
      if (!regla) return true;
      const mensaje = regla(valorDe(control));
      pintarError(control, mensaje);
      return !mensaje;
    }

    const controles = Array.from(
      formulario.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        '#r-nombre, #r-telefono, #r-correo, #r-aviso'
      )
    );

    controles.forEach((control) => {
      // Se valida al salir del campo, no mientras se escribe: corregir a media
      // palabra produce errores que aparecen y desaparecen solos.
      control.addEventListener('blur', () => validar(control));
      control.addEventListener('change', () => {
        if (control.closest('.campo')?.hasAttribute('data-invalido')) validar(control);
      });
    });

    /* -------------------------------- Avisos ------------------------------ */

    function mostrarAviso(tono: 'ok' | 'error', mensaje: string) {
      aviso.dataset.tono = tono;
      aviso.textContent = mensaje;
      aviso.hidden = false;
    }

    function ocultarAviso() {
      aviso.hidden = true;
    }

    function cargando(activo: boolean) {
      boton.dataset.cargando = String(activo);
      boton.disabled = activo;
      const texto = boton.querySelector('.enviar__texto');
      if (texto) texto.textContent = activo ? 'Apartando' : 'Reservar';
    }

    /* -------------------------- Añadir al calendario ----------------------- */

    /* El evento, una sola vez. Los tres destinos (Google, Outlook y el .ics)
       dicen lo mismo porque leen de aquí. */
    type CitaConfirmada = {
      folio: string;
      tratamiento: string;
      cabina: string;
      fecha: string;
      hora: string;
      duracion: number;
    };

    function datosEvento(datos: CitaConfirmada) {
      return {
        titulo: `${datos.tratamiento} en ${marca.nombre}`,
        lugar: `${contacto.calle}, ${contacto.colonia}, ${contacto.cp}`,
        detalle: `Folio ${datos.folio}. Cabina ${datos.cabina}. Tel. ${contacto.telefono}`,
        inicio: instanteUtc(datos.fecha, datos.hora),
        fin: instanteUtc(datos.fecha, datos.hora, datos.duracion),
      };
    }

    /* Google y Outlook abren su web con la cita ya cargada: la clienta solo
       confirma. Es a donde va la mayoría; la descarga queda como tercera
       opción, para quien usa Apple o un cliente de escritorio. */
    function enlaceGoogle(datos: CitaConfirmada) {
      const e = datosEvento(datos);
      const compacto = (i: Date) => i.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const parametros = new URLSearchParams({
        action: 'TEMPLATE',
        text: e.titulo,
        dates: `${compacto(e.inicio)}/${compacto(e.fin)}`,
        details: e.detalle,
        location: e.lugar,
      });
      return `https://calendar.google.com/calendar/render?${parametros}`;
    }

    function enlaceOutlook(datos: CitaConfirmada) {
      const e = datosEvento(datos);
      const iso = (i: Date) => i.toISOString().replace(/\.\d{3}Z$/, 'Z');
      const parametros = new URLSearchParams({
        rru: 'addevent',
        subject: e.titulo,
        startdt: iso(e.inicio),
        enddt: iso(e.fin),
        body: e.detalle,
        location: e.lugar,
        allday: 'false',
      });
      return `https://outlook.live.com/calendar/0/action/compose?${parametros}`;
    }

    function archivoCalendario(datos: CitaConfirmada) {
      const e = datosEvento(datos);
      const sello = (i: Date) => i.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const escapar = (t: string) => t.replace(/([,;\\])/g, '\\$1').replace(/\n/g, '\\n');

      /* RFC 5545: ninguna línea pasa de 75 octetos. Se mide en bytes UTF-8 y se
         corta por carácter, para no dejar media eñe en cada trozo. Sin esto la
         dirección de la casa rompe importaciones estrictas. */
      const plegar = (linea: string) => {
        const medir = (t: string) => new TextEncoder().encode(t).length;
        if (medir(linea) <= 75) return linea;
        const trozos: string[] = [];
        let actual = '';
        let tope = 75;
        for (const c of linea) {
          if (medir(actual + c) > tope) {
            trozos.push(actual);
            actual = c;
            tope = 74; // la continuación gasta un octeto en el espacio inicial
          } else {
            actual += c;
          }
        }
        trozos.push(actual);
        return trozos.join('\r\n ');
      };

      const lineas = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        `PRODID:-//${marca.nombre}//Reservas//ES`,
        'CALSCALE:GREGORIAN',
        'BEGIN:VEVENT',
        `UID:${datos.folio}@${marca.dominio}`,
        `DTSTAMP:${sello(new Date())}`,
        `DTSTART:${sello(e.inicio)}`,
        `DTEND:${sello(e.fin)}`,
        `SUMMARY:${escapar(e.titulo)}`,
        `LOCATION:${escapar(e.lugar)}`,
        `DESCRIPTION:${escapar(e.detalle)}`,
        'BEGIN:VALARM',
        'TRIGGER:-PT2H',
        'ACTION:DISPLAY',
        `DESCRIPTION:${escapar(`Tu cita en ${marca.nombre} es en 2 horas`)}`,
        'END:VALARM',
        'END:VEVENT',
        'END:VCALENDAR',
      ];

      return URL.createObjectURL(
        new Blob([lineas.map(plegar).join('\r\n')], { type: 'text/calendar;charset=utf-8' })
      );
    }

    function cerrarMenuCalendario() {
      menuCalendario.hidden = true;
      abrirCalendario.setAttribute('aria-expanded', 'false');
    }

    abrirCalendario.addEventListener('click', () => {
      if (menuCalendario.hidden) {
        menuCalendario.hidden = false;
        abrirCalendario.setAttribute('aria-expanded', 'true');
        menuCalendario.querySelector<HTMLAnchorElement>('.agregar__opcion')?.focus();
      } else {
        cerrarMenuCalendario();
      }
    });

    menuCalendario.addEventListener('click', cerrarMenuCalendario);

    document.addEventListener('click', (evento) => {
      if (menuCalendario.hidden) return;
      const destino = evento.target;
      if (destino instanceof Element && destino.closest('.agregar')) return;
      cerrarMenuCalendario();
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key !== 'Escape' || menuCalendario.hidden) return;
      cerrarMenuCalendario();
      abrirCalendario.focus();
    });

    /* -------------------------- Pantalla del anticipo --------------------- */

    function pintarReloj(venceEn: string | null) {
      if (relojAnticipo !== null) {
        clearInterval(relojAnticipo);
        relojAnticipo = null;
      }
      if (!venceEn) {
        relojTexto.hidden = true;
        return;
      }

      const refrescar = () => {
        const falta = tiempoRestante(venceEn);
        if (falta) {
          relojTexto.textContent = `Te quedan ${falta} para mandar el anticipo.`;
          relojTexto.dataset.agotado = 'false';
        } else {
          relojTexto.textContent =
            'Se acabó el plazo y la cabina volvió a quedar libre. Si ya transferiste, llámanos y lo resolvemos.';
          relojTexto.dataset.agotado = 'true';
          if (relojAnticipo !== null) clearInterval(relojAnticipo);
          relojAnticipo = null;
        }
      };

      relojTexto.hidden = false;
      refrescar();
      // Cada 30 s. No es un cronómetro: quien transfiere necesita saber si le
      // quedan dos horas o diez minutos, no los segundos.
      relojAnticipo = window.setInterval(refrescar, 30_000);
    }

    function mostrarAvisoComprobante(tono: 'ok' | 'error', mensaje: string) {
      avisoComprobante.dataset.tono = tono;
      avisoComprobante.textContent = mensaje;
      avisoComprobante.hidden = false;
    }

    function mostrarConfirmacion(datos: {
      folio: string;
      tratamiento: string;
      cabina: string;
      fecha: string;
      hora: string;
      duracion: number;
      telefono: string;
      anticipo: number;
      pagoEstado: EstadoPago;
      venceEn: string | null;
    }) {
      document.getElementById('conf-folio')!.textContent = datos.folio;
      document.getElementById('conf-tratamiento')!.textContent = datos.tratamiento;
      document.getElementById('conf-cabina')!.textContent = datos.cabina;
      document.getElementById('conf-cuando')!.textContent =
        `${fechaLegible(datos.fecha)}, ${horaLegible(datos.hora)}`;

      citaEnCurso = { folio: datos.folio, telefono: datos.telefono };
      const esperaAnticipo = datos.anticipo > 0 && datos.pagoEstado === 'esperando';

      const titulo = document.getElementById('conf-titulo')!;
      titulo.textContent = esperaAnticipo
        ? 'Ya casi: falta el anticipo'
        : 'Listo, tu cabina está apartada';

      document.getElementById('conf-texto')!.textContent = esperaAnticipo
        ? HAY_SUPABASE
          ? 'Guardamos tu cita y te apartamos la cabina mientras llega la transferencia.'
          : 'Esta demostración guarda la cita solo en este navegador. Con Supabase conectado, el comprobante llegaría al panel de la casa.'
        : HAY_SUPABASE
          ? 'Te mandamos un recordatorio por WhatsApp el día anterior. Si te surge algo, avísanos con dos horas de anticipación y liberamos la cabina.'
          : 'Esta demostración guarda la cita solo en este navegador. Con Supabase conectado, la cita llegaría al panel de la casa al instante.';

      cajaAnticipo.hidden = !esperaAnticipo;

      if (esperaAnticipo) {
        document.getElementById('anticipo-monto')!.textContent = dinero.format(datos.anticipo);
        document.getElementById('anticipo-folio')!.textContent = datos.folio;
        (document.getElementById('copiar-folio') as HTMLButtonElement).dataset.copiar = datos.folio;
        // Cada reserva empieza limpia: si alguien agenda dos rituales seguidos,
        // el segundo no puede heredar el "ya lo mandaste".
        formComprobante.hidden = false;
        formComprobante.reset();
        listoAnticipo.hidden = true;
        avisoComprobante.hidden = true;
        pintarReloj(datos.venceEn);
      } else {
        pintarReloj(null);
      }

      cerrarMenuCalendario();
      enlaceGoogleCal.href = enlaceGoogle(datos);
      enlaceOutlookCal.href = enlaceOutlook(datos);
      if (urlCalendario) URL.revokeObjectURL(urlCalendario);
      urlCalendario = archivoCalendario(datos);
      enlaceIcs.href = urlCalendario;

      /* Que la clienta escriba primero no es cortesía: abre la ventana de
         servicio de WhatsApp, y dentro de ella la casa responde y recuerda sin
         pagar por plantilla. */
      const mensaje = [
        `Hola, acabo de reservar en ${marca.nombre}.`,
        `${datos.tratamiento}, cabina ${datos.cabina}`,
        `${fechaLegible(datos.fecha)}, ${horaLegible(datos.hora)}`,
        `Folio: ${datos.folio}`,
        ...(esperaAnticipo ? [`Voy a mandar el anticipo de ${dinero.format(datos.anticipo)}.`] : []),
      ].join('\n');

      (document.getElementById('conf-whatsapp') as HTMLAnchorElement).href =
        `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(mensaje)}`;

      formulario.hidden = true;
      confirmada.hidden = false;
      confirmada.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'center',
      });
      titulo.setAttribute('tabindex', '-1');
      titulo.focus();
    }

    /* ------------------------ Copiar CLABE y folio ------------------------
       Nadie teclea 18 dígitos sin equivocarse, y un dígito mal puesto manda el
       dinero a otra cuenta. El botón no es adorno. */

    cajaAnticipo.querySelectorAll<HTMLButtonElement>('.anticipo__copiar').forEach((b) => {
      b.addEventListener('click', async () => {
        const valor = b.dataset.copiar;
        if (!valor) return;
        const etiqueta = b.querySelector('span')!;
        const original = etiqueta.textContent;
        try {
          await navigator.clipboard.writeText(valor);
          etiqueta.textContent = 'Copiado';
          b.dataset.copiado = 'true';
        } catch {
          // Safari sin permiso, o contexto no seguro: se selecciona el texto
          // para que al menos se pueda copiar a mano.
          const dato = b.previousElementSibling;
          if (dato) {
            const rango = document.createRange();
            rango.selectNodeContents(dato);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(rango);
          }
          etiqueta.textContent = 'Selecciónalo';
        }
        window.setTimeout(() => {
          etiqueta.textContent = original;
          delete b.dataset.copiado;
        }, 2000);
      });
    });

    /* --------------------------- Envío del comprobante -------------------- */

    formComprobante.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      avisoComprobante.hidden = true;

      const archivo = campoComprobante.files?.[0];
      if (!archivo) {
        mostrarAvisoComprobante('error', 'Elige la captura de tu transferencia.');
        campoComprobante.focus();
        return;
      }
      if (!citaEnCurso) {
        mostrarAvisoComprobante(
          'error',
          `No encontramos tu reserva en esta pantalla. Mándanos el comprobante por WhatsApp al ${contacto.telefono}.`
        );
        return;
      }

      botonComprobante.dataset.cargando = 'true';
      botonComprobante.disabled = true;
      const textoBoton = botonComprobante.querySelector('.comprobante__texto');
      if (textoBoton) textoBoton.textContent = 'Subiendo';

      try {
        await subirComprobante({
          folio: citaEnCurso.folio,
          telefono: citaEnCurso.telefono,
          archivo,
        });
        formComprobante.hidden = true;
        listoAnticipo.hidden = false;
        avisoComprobante.hidden = true;
        pintarReloj(null);
      } catch (error) {
        const mensaje =
          error instanceof ErrorReserva
            ? error.message
            : `No pudimos subir el comprobante. Mándanoslo por WhatsApp al ${contacto.telefono}.`;
        mostrarAvisoComprobante('error', mensaje);
      } finally {
        botonComprobante.dataset.cargando = 'false';
        botonComprobante.disabled = false;
        if (textoBoton) textoBoton.textContent = 'Enviar comprobante';
      }
    });

    /* --------------------------------- Envío ------------------------------ */

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      ocultarAviso();

      if (!diaElegido || !horaElegida) {
        mostrarAviso('error', 'Falta elegir el día y la hora de tu cita.');
        document.getElementById('calendario')?.scrollIntoView({ block: 'center' });
        return;
      }

      const validos = controles.map((c) => validar(c));
      if (validos.includes(false)) {
        const primerFallo = formulario.querySelector<HTMLElement>(
          '[data-invalido] input, [data-invalido] textarea'
        );
        primerFallo?.focus();
        mostrarAviso('error', 'Revisa los campos marcados y vuelve a enviar.');
        return;
      }

      const trat = tratamientoElegido();
      const cab = cabinaElegida();
      const datos = new FormData(formulario);
      const telefono = String(datos.get('telefono') ?? '');

      cargando(true);

      try {
        /* Solo viaja QUÉ se eligió. El precio, la duración, el buffer y el
           anticipo los pone la base; lo que vuelve es lo que quedó guardado. */
        const hecha = await reservar({
          nombre: String(datos.get('nombre') ?? ''),
          telefono,
          correo: String(datos.get('correo') ?? '') || null,
          tratamientoSlug: trat.slug,
          cabinaSlug: cab.slug,
          fecha: diaElegido,
          hora: horaElegida,
          notas: String(datos.get('notas') ?? '') || null,
        });

        mostrarConfirmacion({
          folio: hecha.folio,
          tratamiento: hecha.tratamientoNombre,
          cabina: hecha.cabinaNombre,
          fecha: diaElegido,
          hora: horaElegida,
          duracion: hecha.duracionMin,
          telefono,
          anticipo: hecha.anticipo,
          pagoEstado: hecha.pagoEstado,
          venceEn: hecha.venceEn,
        });

        formulario.reset();
      } catch (error) {
        const mensaje =
          error instanceof ErrorReserva
            ? error.message
            : `No pudimos guardar la cita. Llámanos al ${contacto.telefono} y la agendamos por teléfono.`;
        mostrarAviso('error', mensaje);

        if (error instanceof ErrorReserva && error.codigo === 'HORA_OCUPADA') {
          horaElegida = null;
          await traerAgenda();
          actualizarResumen();
        }
      } finally {
        cargando(false);
      }
    });

    document.getElementById('conf-otra')!.addEventListener('click', async () => {
      confirmada.hidden = true;
      formulario.hidden = false;
      diaElegido = null;
      horaElegida = null;
      ocultarAviso();
      cajaAnticipo.hidden = true;
      citaEnCurso = null;
      pintarReloj(null);
      await traerAgenda();
      actualizarResumen();
      formulario.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* ------------------------- Cambios de selección ----------------------- */

    formulario
      .querySelectorAll<HTMLInputElement>('input[name="tratamiento"], input[name="cabina"]')
      .forEach((radio) => {
        radio.addEventListener('change', () => {
          // Cambiar tratamiento o cabina cambia qué horas caben: la elegida
          // puede haber dejado de existir.
          horaElegida = null;
          if (diaElegido && agenda) {
            const t = tratamientoElegido();
            const c = cabinaElegida();
            if (!diaTieneHuecos(agenda, diaElegido, t, c.slug)) diaElegido = null;
          }
          pintarCalendario();
          pintarHorarios();
          actualizarResumen();
        });
      });

    /* Las tarjetas del riel mandan aquí con el tratamiento ya elegido. */
    document.addEventListener('elegir-tratamiento', (evento) => {
      const slug = (evento as CustomEvent<{ slug: string }>).detail?.slug;
      if (!slug || !catalogo.some((t) => t.slug === slug)) return;
      const radio = formulario.querySelector<HTMLInputElement>(
        `input[name="tratamiento"][value="${slug}"]`
      );
      if (radio && !radio.checked) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });

    atras.addEventListener('click', () => {
      mesVisible =
        mesVisible.mes === 1
          ? { anio: mesVisible.anio - 1, mes: 12 }
          : { anio: mesVisible.anio, mes: mesVisible.mes - 1 };
      pintarCalendario();
    });

    adelante.addEventListener('click', () => {
      mesVisible =
        mesVisible.mes === 12
          ? { anio: mesVisible.anio + 1, mes: 1 }
          : { anio: mesVisible.anio, mes: mesVisible.mes + 1 };
      pintarCalendario();
    });

    actualizarResumen();
    pintarCalendario();
    pintarHorarios();
    traerAgenda();
  }
</script>

