    width: 14px;
    height: 14px;
    flex: none;
    margin-top: 2px;
  }

  /* -------------------------------- Móvil -------------------------------- */

  @media (max-width: 960px) {
    .flujo {
      grid-template-columns: minmax(0, 1fr);
    }

    /* El resumen cae justo antes del botón, que es donde de verdad se necesita
       revisar el precio antes de confirmar. */
    .resumen {
      grid-column: 1;
      grid-row: auto;
      position: static;
      order: 99;
    }

    .enviar {
      order: 100;
    }

    .aviso {
      order: 101;
    }
  }
</style>

<!-- Las celdas del calendario y los chips de hora los crea el JavaScript, así
     que sus estilos van en un bloque global: en el bloque normal Astro los
     descartaría por no encontrarlos en el marcado. -->
<style is:global>
  #calendario-rejilla .dia {
    /* Algo más anchas que altas: a cuadro perfecto el calendario se come
       demasiado alto en móvil. */
    aspect-ratio: 8 / 7;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: var(--r-inner);
    background: transparent;
    color: var(--ink-3);
    font-size: 0.844rem;
    font-variant-numeric: tabular-nums;
    cursor: not-allowed;
  }

  #calendario-rejilla .dia--hueco {
    border: 0;
  }

  /* Un día con lugar tiene que verse pulsable de un vistazo. El punto de abajo
     lo marca sin depender solo del color del borde. */
  #calendario-rejilla .dia--libre {
    border-color: var(--linea-fuerte);
    color: var(--ink);
    cursor: pointer;
    position: relative;
    transition:
      border-color 0.18s var(--ease),
      background 0.18s var(--ease);
  }

  #calendario-rejilla .dia--libre::after {
    content: '';
    position: absolute;
    bottom: 6px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--acento);
  }

  #calendario-rejilla .dia--libre:hover {
    border-color: var(--ink);
    background: var(--sup);
  }

  #calendario-rejilla .dia--elegido,
  #calendario-rejilla .dia--elegido:hover {
    background: var(--tinta);
    border-color: var(--tinta);
    color: var(--hueso);
  }

  #calendario-rejilla .dia--elegido::after {
    background: var(--hueso);
  }

  /* Mes sin lugar: ocupa la rejilla completa y ofrece el salto al mes que sí
     tiene. Un mes apagado sin explicación se lee como "no hay lugar nunca". */
  #calendario-rejilla .calendario__sin-mes {
    grid-column: 1 / -1;
    padding: 16px 0 4px;
    font-size: 0.844rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  #calendario-rejilla .calendario__salto {
    display: inline-block;
    margin-top: 2px;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--acento-texto);
    font: inherit;
    font-size: 0.844rem;
    text-decoration: underline;
    cursor: pointer;
  }

  /* -------------------------------- Horarios ------------------------------ */

  #horarios .horarios__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 7px;
  }

  #horarios .horarios__vacio {
    font-size: 0.844rem;
    color: var(--ink-3);
  }

  #horarios .hora {
    padding: 10px 6px;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink);
    font-size: 0.813rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition:
      border-color 0.18s var(--ease),
      background 0.18s var(--ease);
  }

  #horarios .hora:hover:not(:disabled) {
    border-color: var(--ink);
    background: var(--sup);
  }

  /* Hora anclada al minuto en que la cabina queda libre. Se marca con un punto
     porque es la que llena mejor la tarde, y verla distinta ayuda a elegirla. */
  #horarios .hora[data-anclado='true'] {
    position: relative;
  }

  #horarios .hora[data-anclado='true']::before {
    content: '';
    position: absolute;
    top: 7px;
    right: 9px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--acento);
  }

  /* Hora ya reservada: se ve, para que se note que la casa está llena a esa
     hora, en vez de desaparecer y dejar la duda. */
  #horarios .hora:disabled {
    border-color: transparent;
    background: transparent;
    color: var(--ink-3);
    text-decoration: line-through;
    cursor: not-allowed;
  }

  #horarios .hora--elegida,
  #horarios .hora--elegida:hover {
    background: var(--tinta);
    border-color: var(--tinta);
    color: var(--hueso);
  }

  #horarios .hora--elegida[data-anclado='true']::before {
    background: var(--hueso);
  }

  #horarios .horarios__pie {
    margin-top: 12px;
    font-size: 0.781rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* Las horas que dejarían hueco muerto: disponibles, pero fuera del camino por
     defecto. Acordeón nativo, sin JavaScript de más. */
  #horarios .horarios__otros {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--linea);
  }

  #horarios .horarios__otros summary {
    font-size: 0.813rem;
    color: var(--acento-texto);
    cursor: pointer;
  }

  #horarios .horarios__nota {
    margin: 10px 0 13px;
    font-size: 0.781rem;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 62ch;
  }
</style>
