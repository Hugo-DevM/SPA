---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import { marca, contacto, pieEnlaces } from '../data/spa';

const anio = new Date().getFullYear();
---

<!-- Pie en taupe: cierra la página con el bloque más oscuro del sistema, sin
     salirse de la familia cálida. Cuatro columnas, no cinco: el horario cabe
     en la columna de contacto y una columna menos se lee mejor. -->
<footer class="pie lienzo--taupe">
  <div class="envoltura">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <Logo />
        <p class="pie__claim">{marca.claim}</p>

        <ul class="pie__redes">
          {
            contacto.redes.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre}>
                  <Icon name={r.icono} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pie__grupo">
        <h2>Contacto</h2>
        <ul class="pie__contacto">
          <li><a href={`tel:${contacto.telefonoHref}`}>{contacto.telefono}</a></li>
          <li><a href={`mailto:${contacto.correo}`}>{contacto.correo}</a></li>
          <li>
            <a href={contacto.mapa} target="_blank" rel="noopener">
              {contacto.calle}, {contacto.colonia}
            </a>
          </li>
        </ul>

        <dl class="pie__horario">
          {
            contacto.horarios.map((h) => (
              <div>
                <dt>{h.dias}</dt>
                <dd>{h.horas}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {
        pieEnlaces
          .filter((g) => g.titulo !== 'Tratamientos')
          .map((grupo) => (
            <nav class="pie__grupo" aria-label={grupo.titulo}>
              <h2>{grupo.titulo}</h2>
              <ul>
                {grupo.enlaces.map((e) => (
                  <li>
                    <a href={e.href}>{e.etiqueta}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
      }
    </div>

    <div class="pie__bajo">
      <p>© {anio} {marca.nombre}. Marca ficticia de demostración.</p>
      <p>
        Sitio y sistema de agenda por
        <a class="enlace" href="https://hamcsoft.com" target="_blank" rel="noopener">HAMCSoft</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .pie {
    padding-block: clamp(50px, 6vw, 86px) clamp(24px, 3vw, 36px);
    /* Espacio para la barra móvil fija, que si no tapa el último renglón. */
    padding-bottom: calc(clamp(24px, 3vw, 36px) + 74px);
  }

  @media (min-width: 821px) {
    .pie {
      padding-bottom: clamp(24px, 3vw, 36px);
    }
  }

  .pie__rejilla {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
    gap: clamp(26px, 3vw, 48px);
  }

  .pie__claim {
    margin-top: 16px;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 26ch;
  }

  .pie__redes {
    display: flex;
    gap: 9px;
    margin-top: 22px;
    list-style: none;
  }

  .pie__redes a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--linea-fuerte);
    border-radius: 50%;
    color: var(--ink-2);
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .pie__redes a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .pie__redes svg {
    width: 16px;
    height: 16px;
  }

  .pie__grupo h2 {
    font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.688rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .pie__grupo ul {
    display: grid;
    gap: 9px;
    margin-top: 16px;
    list-style: none;
  }

  .pie__grupo a {
    font-size: 0.844rem;
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }

  .pie__grupo a:hover {
    opacity: 0.65;
  }

  .pie__contacto li {
    line-height: 1.5;
  }

  .pie__horario {
    display: grid;
    gap: 7px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--linea);
  }

  .pie__horario dt {
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .pie__horario dd {
    font-size: 0.813rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .pie__bajo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-top: clamp(32px, 4vw, 54px);
    padding-top: 22px;
    border-top: 1px solid var(--linea);
    font-size: 0.781rem;
    color: var(--ink-2);
  }

  @media (max-width: 1000px) {
    .pie__rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .pie__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
