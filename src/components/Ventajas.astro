---
import { Icon } from 'astro-icon/components';
import { ventajas } from '../data/spa';
---

<!-- Familia: rejilla 2x2 de tarjetas con icono, con el título a la izquierda.

     Está aquí por el ORDEN, no por el relleno: justo después viene un
     formulario que pide nombre, teléfono y a veces una transferencia, y hasta
     ahora llegaba sin haber dado un motivo para confiar.

     Dos y dos, no cuatro en fila: cuatro tarjetas iguales a lo ancho es la
     salida fácil y deja cada texto en una columna de ocho caracteres. -->
<section class="ventajas seccion lienzo--blanco" aria-labelledby="ventajas-titulo">
  <div class="envoltura ventajas__rejilla">
    <div class="ventajas__alto revelar">
      <p class="sobre-titulo">{ventajas.titulo} {ventajas.tituloAcento}</p>
      <h2 id="ventajas-titulo">Por qué aquí</h2>
      <p class="entrada ventajas__texto">{ventajas.texto}</p>
    </div>

    <ul class="ventajas__lista revelar">
      {
        ventajas.lista.map((v) => (
          <li class="ventaja tarjeta tarjeta--alzable">
            <span class="ventaja__icono" aria-hidden="true">
              <Icon name={v.icono} />
            </span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ventajas__rejilla {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(26px, 4vw, 70px);
    align-items: start;
  }

  /* El título se queda fijo mientras pasan las cuatro tarjetas. Mismo recurso
     que en preguntas, y esta es la segunda y última vez que aparece. */
  .ventajas__alto {
    position: sticky;
    top: calc(var(--alto-cabecera) + 24px);
  }

  .ventajas__alto h2 {
    margin-top: 12px;
  }

  .ventajas__texto {
    margin-top: 18px;
    max-width: 34ch;
  }

  .ventajas__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    list-style: none;
  }

  /* `--sup-2` y no `--sup`: sobre el lienzo blanco, `--sup` es hueso y la
     diferencia contra el fondo es de un 1%. La tarjeta existía y no se veía. */
  .ventaja {
    padding: clamp(22px, 2.4vw, 30px);
    background: var(--sup-2);
  }

  /* Disco terracota tenue con el glifo en acento. El terracota pleno aquí
     daría 3.69 contra el crema: sirve para un relleno, no para un icono que
     hay que distinguir. */
  .ventaja__icono {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgb(194 105 58 / 0.16);
    color: var(--acento-texto);
  }

  .ventaja__icono svg {
    width: 20px;
    height: 20px;
  }

  .ventaja h3 {
    margin-top: 18px;
  }

  .ventaja p {
    margin-top: 8px;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  @media (max-width: 980px) {
    .ventajas__rejilla {
      grid-template-columns: 1fr;
    }

    .ventajas__alto {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .ventajas__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
